<?xml version="1.0" encoding="UTF-8"?>
<!--
    VOXY MSI Installer — WiX v4 Configuration
    Build: wix build voxy.wixproj
-->
<Project Schemas="wix/4">
  <Package Name="VOXY"
           Manufacturer="VOXY Engineering Team"
           Version="!( bind.FileVersion(targetPath\voxy-daemon.exe) )"
           UpgradeCode="A1B2C3D4-E5F6-7890-ABCD-EF1234567890"
           Scope="perMachine">

    <SummaryInformation
      Description="VOXY — Autonomous AI Operating System"
      Manufacturer="VOXY Engineering Team"
      ProductCode="*" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of VOXY is already installed." />

    <Feature Id="Main">
      <ComponentRef Id="Daemon" />
      <ComponentRef Id="Overlay" />
      <ComponentRef Id="ConfigDir" />
      <ComponentRef Id="LogsDir" />
      <ComponentRef Id="StartMenu" />
      <ComponentRef Id="PathEnv" />
    </Feature>

    <Feature Id="Desktop" Title="Desktop Shortcut" Absent="allow">
      <ComponentRef Id="DesktopShortcut" />
    </Feature>

    <StandardDirectory Id="ProgramFilesFolder">
      <Directory Id="INSTALLDIR" Name="VOXY">
        <Component Id="Daemon" Guid="*">
          <File Id="daemon" Source="$(sys.CURRENTDIR)target\release\voxy-daemon.exe" />
        </Component>
        <Component Id="Overlay" Guid="*">
          <File Id="overlay" Source="$(sys.CURRENTDIR)target\release\voxy-overlay.exe" />
        </Component>
        <Directory Id="ConfigDir" Name="config">
          <Component Id="ConfigDir" Guid="*">
            <CreateFolder />
          </Component>
        </Directory>
        <Directory Id="LogsDir" Name="logs">
          <Component Id="LogsDir" Guid="*">
            <CreateFolder />
          </Component>
        </Directory>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ProgramsFolder" Name="VOXY">
        <Component Id="StartMenu" Guid="*">
          <Shortcut Id="DaemonShortcut"
                    Name="VOXY Daemon"
                    Target="[INSTALLDIR]voxy-daemon.exe"
                    WorkingDirectory="INSTALLDIR" />
          <Shortcut Id="UninstallShortcut"
                    Name="Uninstall VOXY"
                    Target="[System64Folder]msiexec.exe"
                    Arguments="/x [ProductCode]" />
          <RemoveFolder Id="CleanupPrograms" Directory="ProgramsFolder" On="uninstall" />
          <RegistryValue Root="HKCU" Key="Software\VOXY\Shortcuts" Name="StartMenu" Type="integer" Value="1" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder">
      <Component Id="DesktopShortcut" Guid="*" Condition="desktop">
        <Shortcut Id="DesktopShortcut"
                  Name="VOXY"
                  Target="[INSTALLDIR]voxy-daemon.exe"
                  WorkingDirectory="INSTALLDIR" />
        <RegistryValue Root="HKCU" Key="Software\VOXY\Shortcuts" Name="Desktop" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <Environment Id="PathEnv" Name="PATH" Value="[INSTALLDIR]" Permanent="no" Part="last" Action="set" System="yes" />

    <Icon Id="VoxyIcon" SourceFile="$(sys.CURRENTDIR)assets\icons\voxy.ico" />
    <Property Id="ARPPRODUCTICON" Value="VoxyIcon" />

    <WixVariable Id="WixUILicenseRtf" Value="$(sys.CURRENTDIR)installer\license.rtf" />
    <UIRef Id="WixUI_InstallDir" />

  </Package>
</Project>
